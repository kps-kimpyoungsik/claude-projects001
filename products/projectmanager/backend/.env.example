# 원격 PostgreSQL 접속 정보 (실제 값은 .env 에 — git 제외)
PM_DB_HOST=<db-host>
PM_DB_PORT=5432
PM_DB_NAME=<db-name>
PM_DB_USER=<db-user>
PM_DB_PASSWORD=

# 쓰기 API 키 — 비우면 검사 안 함(로컬 전용). 프론트 frontend/.env.local 의 VITE_API_KEY 와 같은 값
PM_API_KEY=

# 개인정보 보호 (plans/_opens/pii_protection) — 값은 이 파일이 아니라 .env 에
#   색인키 생성: java src/main/java/com/aegis/pm/pii/PiiCrypto.java indexkey
#   키쌍 생성:   java src/main/java/com/aegis/pm/pii/PiiCrypto.java keygen <저장소 밖 디렉터리>
PM_PII_INDEX_KEY=
PM_PII_PRIVATE_KEY=
PM_PII_REVEAL=false
